      "id": "arc",
      "title": "Open in Arc",
      "icon": "lineicons:arc-browser",
      "type": "shell",
      "scriptCode": "open -b company.thebrowser.Browser \"$OPENCLIP_TEXT\" 2>/dev/null || echo '{\"type\":\"toast\",\"message\":\"Browser Not Available\",\"style\":\"error\"}'",
      "requirements": {
        "regex": "https?://",
        "apps": [
          "company.thebrowser.Browser"
        ],
        "appsMode": "deny"
      }
